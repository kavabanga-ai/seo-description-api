# Database
DATABASE_URL=postgresql://user:password@localhost:5432/seo_descriptions

# API Configuration
API_KEY=your-api-key-here
API_HOST=0.0.0.0
API_PORT=8000

# Dify AI Service
DIFY_API_URL=https://luis-agents.kavabanga.team/v1
DIFY_API_KEY=your-dify-api-key-here
DIFY_TIMEOUT=120  # Timeout in seconds (2 minutes default)

# Scheduler
SCHEDULER_INTERVAL_SECONDS=5
BATCH_SIZE=10

# Retry Configuration
MAX_RETRIES=1  # Number of retries before marking as failed
RETRY_DELAY=20  # Delay between retries in seconds

# CORS
ALLOWED_ORIGINS="http://localhost:3000,https://myfrontend.com"